PROJECT_NAME="StudyMate AI Backend"
API_V1_STR="/api/v1"
DEBUG=True

# Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="studymate-ai"

# Priority Weights: P = 0.35D + 0.30U + 0.20W + 0.15I
WEIGHT_DIFFICULTY=0.35
WEIGHT_URGENCY=0.30
WEIGHT_WEAKNESS=0.20
WEIGHT_IMPORTANCE=0.15

# Development Mode (Enables offline mock authentication for local development and testing)
ALLOW_DEV_AUTH=True
